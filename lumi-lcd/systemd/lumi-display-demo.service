[Unit]
Description=LUMI LCD35 framebuffer demo
StartLimitIntervalSec=60
StartLimitBurst=3
After=systemd-udev-trigger.service

[Service]
Type=simple
User=lumi-display
Group=lumi-display
SupplementaryGroups=video
ExecStart=/usr/bin/python3 -B /opt/lumi-lcd/demo.py --without-touch
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
DevicePolicy=closed
DeviceAllow=char-fb rw
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
